@model SmartStorage.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-dark text-white text-center rounded-top-4 py-4">
                    <i class="bi bi-shield-lock fs-1"></i>
                    <h3 class="mb-0 mt-2">Change Password</h3>
                    <p class="text-gold mt-2 mb-0">Update your security settings</p>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="ChangePassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Current Password -->
                        <div class="form-floating mb-3">
                            <input asp-for="CurrentPassword" class="form-control" placeholder="Current Password" type="password" />
                            <label asp-for="CurrentPassword">
                                <i class="bi bi-key me-1"></i> Current Password
                            </label>
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <!-- New Password -->
                        <div class="form-floating mb-3">
                            <input asp-for="NewPassword" class="form-control" placeholder="New Password" type="password" />
                            <label asp-for="NewPassword">
                                <i class="bi bi-key-fill me-1"></i> New Password
                            </label>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            <div class="form-text">Password must be at least 6 characters</div>
                        </div>

                        <!-- Confirm Password -->
                        <div class="form-floating mb-4">
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm New Password" type="password" />
                            <label asp-for="ConfirmPassword">
                                <i class="bi bi-key me-1"></i> Confirm New Password
                            </label>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-gold w-100 py-3">
                            <i class="bi bi-save me-2"></i> Change Password
                        </button>

                        <hr class="my-4" />

                        <!-- Back to Profile Link -->
                        <p class="text-center mb-0">
                            <a asp-action="Profile" class="text-decoration-none" style="color: #D4AF37;">
                                <i class="bi bi-arrow-left me-1"></i> Back to Profile
                            </a>
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: #D4AF37;
    }
    
    .btn-gold {
        background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);
        color: #1A1A1A;
        font-weight: 600;
        border: none;
        transition: all 0.3s ease;
    }
    
    .btn-gold:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(212, 175, 55, 0.3);
        color: #1A1A1A;
    }
    
    .form-floating > .form-control:focus {
        border-color: #D4AF37;
        box-shadow: 0 0 0 0.2rem rgba(212, 175, 55, 0.25);
    }
    
    .card {
        background: #FFFFFF;
    }
    
    .card-header {
        background: linear-gradient(135deg, #2C2C2C 0%, #1A1A1A 100%);
    }
    
    .rounded-top-4 {
        border-top-left-radius: 1rem !important;
        border-top-right-radius: 1rem !important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}