@{
    ViewData["Title"] = "Update Status";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg">
                <div class="card-header text-center py-4" style="background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);">
                    <i class="bi bi-toggle-on fs-1 text-white"></i>
                    <h3 class="text-white mb-0 mt-2">Update Status</h3>
                    <p class="text-white-50 mb-0">Current Status: @ViewBag.CurrentStatus</p>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="UpdateStatus" method="post">
                        <div class="mb-3">
                            <label class="form-label">Select Status</label>
                            <select name="status" class="form-select" required>
                                <option value="Available">Available</option>
                                <option value="OnDelivery">On Delivery</option>
                                <option value="Break">Break</option>
                                <option value="OffDuty">Off Duty</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-gold w-100">Update Status</button>
                        <a href="/Driver/Dashboard" class="btn btn-outline-secondary w-100 mt-2">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-gold {
        background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);
        color: #2c2c2c;
        font-weight: 600;
        border: none;
    }
</style>