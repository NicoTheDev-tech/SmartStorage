@model IEnumerable<SmartStorage.Core.Entities.ContractExtension>
@{
    ViewData["Title"] = "Extension History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5 fw-bold">Extension History</h1>
            <p class="text-muted">Track all your contract extension requests</p>
        </div>
        <a href="/Customer/MyContracts" class="btn btn-outline-gold">Back to Contracts</a>
    </div>

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Contract #</th>
                            <th>Unit</th>
                            <th>Requested Days</th>
                            <th>Requested Date</th>
                            <th>Current End Date</th>
                            <th>Proposed New End Date</th>
                            <th>Status</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var ext in Model)
                            {
                                <tr>
                                    <td>@ext.Contract?.ContractNumber</td>
                                    <td>@ext.Contract?.Booking?.StorageUnit?.UnitNumber</td>
                                    <td>@ext.RequestedDays days</td>
                                    <td>@ext.RequestedDate.ToString("dd MMM yyyy")</td>
                                    <td>@ext.CurrentEndDate.ToString("dd MMM yyyy")</td>
                                    <td>@ext.ProposedNewEndDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @if (ext.Status == "Pending")
                                        {
                                            <span class="badge bg-warning">Pending</span>
                                        }
                                        else if (ext.Status == "Approved")
                                        {
                                            <span class="badge bg-success">Approved</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Rejected</span>
                                        }
                                    </td>
                                    <td>@ext.Reason</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <i class="bi bi-inbox fs-1 text-muted"></i>
                                    <p class="text-muted mt-2">No extension requests yet</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-outline-gold {
        border: 2px solid #D4AF37;
        color: #D4AF37;
        background: transparent;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    .btn-outline-gold:hover {
        background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);
        color: #1A1A1A;
        border-color: transparent;
        transform: translateY(-2px);
    }
    .badge {
        font-size: 0.8rem;
        padding: 5px 10px;
    }
    .table > :not(caption) > * > * {
        vertical-align: middle;
    }
</style>