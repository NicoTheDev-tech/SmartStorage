@{
    ViewData["Title"] = "Storage Occupancy";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var occupancy = ViewBag.Occupancy as dynamic;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5 fw-bold">Storage Occupancy</h1>
            <p class="text-muted">Monitor and report on all storage units occupancy levels</p>
        </div>
        <a href="/Warehouse/Dashboard" class="btn btn-outline-gold">Back to Dashboard</a>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body">
                    <i class="bi bi-building fs-1 float-end"></i>
                    <h2 class="mb-0">@occupancy.Total</h2>
                    <p class="mb-0">Total Units</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success text-white">
                <div class="card-body">
                    <i class="bi bi-check-circle-fill fs-1 float-end"></i>
                    <h2 class="mb-0">@occupancy.Available</h2>
                    <p class="mb-0">Available Units</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-warning text-dark">
                <div class="card-body">
                    <i class="bi bi-clock-history fs-1 float-end"></i>
                    <h2 class="mb-0">@occupancy.Reserved</h2>
                    <p class="mb-0">Reserved Units</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-danger text-white">
                <div class="card-body">
                    <i class="bi bi-box-seam fs-1 float-end"></i>
                    <h2 class="mb-0">@occupancy.Occupied</h2>
                    <p class="mb-0">Occupied Units</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Occupancy Progress Bar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h5 class="mb-3">Overall Occupancy Rate</h5>
            <div class="progress" style="height: 30px;">
                <div class="progress-bar bg-danger" role="progressbar" 
                     style="width: @occupancy.OccupancyPercentage%" 
                     aria-valuenow="@occupancy.OccupancyPercentage" 
                     aria-valuemin="0" 
                     aria-valuemax="100">
                    @occupancy.OccupancyPercentage% Occupied
                </div>
            </div>
        </div>
    </div>

    <!-- Occupied Units List -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 pt-4">
            <h5 class="mb-0"><i class="bi bi-list-check text-gold"></i> Currently Occupied Units</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Unit Number</th>
                            <th>Customer</th>
                            <th>Start Date</th>
                            <th>Contract End Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.OccupiedUnits != null && ViewBag.OccupiedUnits.Count > 0)
                        {
                            foreach (var item in ViewBag.OccupiedUnits)
                            {
                                <tr>
                                    <td class="fw-bold">@item.StorageUnit.UnitNumber</td>
                                    <td>@item.Client?.FullName</td>
                                    <td>@(item.CreatedAt.HasValue ? item.CreatedAt.Value.ToString("dd MMM yyyy") : "N/A")</td>
                                    <td>
                                        @if (item.EndDate.HasValue)
                                        {
                                            @item.EndDate.Value.ToString("dd MMM yyyy")
                                            if (item.EndDate.Value < DateTime.Now)
                                            {
                                                <span class="badge bg-danger ms-2">Expired</span>
                                            }
                                            else if (item.EndDate.Value < DateTime.Now.AddDays(30))
                                            {
                                                <span class="badge bg-warning ms-2">Expiring Soon</span>
                                            }
                                        }
                                        else
                                        {
                                            <span>N/A</span>
                                        }
                                    </td>
                                    <td><span class="badge bg-success">Active</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <i class="bi bi-inbox fs-1 text-muted"></i>
                                    <p class="text-muted mt-2">No occupied units</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-outline-gold {
        border: 2px solid #D4AF37;
        color: #D4AF37;
        background: transparent;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    .btn-outline-gold:hover {
        background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);
        color: #1A1A1A;
        border-color: transparent;
        transform: translateY(-2px);
    }
    .progress-bar {
        transition: width 0.5s ease;
    }
    .card {
        transition: transform 0.2s;
        border-radius: 12px;
    }
    .card:hover {
        transform: translateY(-3px);
    }
    .bg-primary {
        background: linear-gradient(135deg, #2563eb, #1e40af) !important;
    }
    .bg-success {
        background: linear-gradient(135deg, #16a34a, #15803d) !important;
    }
    .bg-warning {
        background: linear-gradient(135deg, #eab308, #ca8a04) !important;
    }
    .bg-danger {
        background: linear-gradient(135deg, #dc2626, #b91c1c) !important;
    }
    .text-gold {
        color: #D4AF37;
    }
    .table > :not(caption) > * > * {
        vertical-align: middle;
    }
</style>
<script>
    $(document).ready(function() {
        $('.driver-select').change(function() {
            var scheduleId = $(this).data('schedule-id');
            var driverId = $(this).val();
            
            if (driverId) {
                $.ajax({
                    url: '/Warehouse/AssignDriver',
                    type: 'POST',
                    data: {
                        scheduleId: scheduleId,
                        driverId: driverId
                    },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            toastr.success(response.message);
                            location.reload();
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function() {
                        toastr.error('Error assigning driver');
                    }
                });
            }
        });
    });
</script>