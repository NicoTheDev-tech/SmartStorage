@model List<SmartStorage.Core.DTOs.DeliveryScheduleResponseDto>
@{
    ViewData["Title"] = "Delivery Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);">
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <div class="d-flex align-items-center mb-2">
                                <div class="me-3 p-2 bg-white bg-opacity-20 rounded-3">
                                    <i class="bi bi-truck fs-1 text-gold"></i>
                                </div>
                                <div>
                                    <h1 class="text-white mb-1 fw-bold">Delivery Management</h1>
                                    <p class="text-white-50 mb-0">Manage and assign drivers to transport jobs</p>
                                </div>
                            </div>
                            <div class="mt-3">
                                <span class="badge bg-light text-dark me-2 p-2">Driver Assignment</span>
                                <span class="badge bg-light text-dark p-2">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</span>
                            </div>
                        </div>
                        <div class="col-md-4 text-end">
                            <a href="/Admin/Dashboard" class="btn btn-outline-light rounded-pill">
                                <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-lg rounded-4">
        <div class="card-header bg-white border-0 pt-4 pb-0">
            <h5 class="mb-0 fw-bold"><i class="bi bi-truck text-gold me-2"></i>Transport Jobs</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="deliveryTable">
                    <thead class="table-light">
                        <tr>
                            <th>Schedule #</th>
                            <th>Client</th>
                            <th>Unit</th>
                            <th>Delivery Type</th>
                            <th>Scheduled Date</th>
                            <th>Time Slot</th>
                            <th>Status</th>
                            <th>Assign Driver</th>
                            <th>Current Driver</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var schedule in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@schedule.ScheduleNumber</td>
                                    <td>@schedule.ClientName</td>
                                    <td>@schedule.UnitNumber</td>
                                    <td>
                                        @if (schedule.DeliveryType == "Dropoff")
                                        {
                                            <span class="badge bg-info">Dropoff</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Collection</span>
                                        }
                                    </td>
                                    <td>@schedule.ScheduledDate.ToString("dd MMM yyyy")</td>
                                    <td>@schedule.TimeSlot</td>
                                    <td>
                                        @if (schedule.Status == "Pending")
                                        {
                                            <span class="badge bg-warning rounded-pill">Pending</span>
                                        }
                                        else if (schedule.Status == "Confirmed")
                                        {
                                            <span class="badge bg-info rounded-pill">Confirmed</span>
                                        }
                                        else if (schedule.Status == "InProgress")
                                        {
                                            <span class="badge bg-primary rounded-pill">In Progress</span>
                                        }
                                        else if (schedule.Status == "Completed")
                                        {
                                            <span class="badge bg-success rounded-pill">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill">@schedule.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm driver-select" data-delivery-id="@schedule.Id" style="min-width: 180px;">
                                            <option value="">-- Select Driver --</option>
                                            @if (ViewBag.Drivers != null)
                                            {
                                                foreach (var driver in ViewBag.Drivers)
                                                {
                                                    <option value="@driver.Id">@driver.FullName - @driver.VehicleAssigned</option>
                                                }
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(schedule.AssignedDriver))
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-person-check me-1"></i> @schedule.AssignedDriver
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Not Assigned</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5">
                                    <i class="bi bi-inbox fs-1 text-muted"></i>
                                    <p class="text-muted mt-2">No delivery schedules found</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: #D4AF37 !important;
    }
    .rounded-4 {
        border-radius: 1rem !important;
    }
    .driver-select {
        cursor: pointer;
        border-radius: 20px;
        font-size: 0.875rem;
    }
    .driver-select:focus {
        border-color: #D4AF37;
        box-shadow: 0 0 0 0.2rem rgba(212, 175, 55, 0.25);
    }
    .btn-outline-light:hover {
        background: #D4AF37;
        border-color: #D4AF37;
        color: #1A1A1A;
    }
    .table > :not(caption) > * > * {
        vertical-align: middle;
    }
</style>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            // Handle driver assignment
            $('.driver-select').on('change', function() {
                var deliveryId = $(this).data('delivery-id');
                var driverId = $(this).val();
                
                if (driverId) {
                    $.ajax({
                        url: '/Admin/AssignDriverToDelivery',
                        type: 'POST',
                        data: {
                            deliveryId: deliveryId,
                            driverId: driverId
                        },
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                alert(response.message);
                                location.reload();
                            } else {
                                alert(response.message);
                            }
                        },
                        error: function() {
                            alert('Error assigning driver');
                        }
                    });
                }
            });
        });
    </script>
}