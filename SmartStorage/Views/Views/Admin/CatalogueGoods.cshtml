@model SmartStorage.Core.Entities.AssetForSale
@{
    ViewData["Title"] = "Catalogue Goods for Sale";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-0">Catalogue Goods for Sale</h1>
            <p class="text-muted">Inspecting and recording goods approved for sale - Customer: @ViewBag.CustomerName</p>
        </div>
        <a href="/Admin/ViewCatalogue/@ViewBag.BreachCaseId" class="btn btn-outline-gold">View Catalogue</a>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-4">
                    <h5 class="mb-0">Add New Item</h5>
                </div>
                <div class="card-body">
                    <form method="post" action="/Admin/CatalogueGoods">
    @Html.AntiForgeryToken()
    <input type="hidden" name="BreachCaseId" value="@ViewBag.BreachCaseId" />
    
    <div class="mb-3">
        <label class="form-label">Item Name *</label>
        <input type="text" name="ItemName" class="form-control" required />
    </div>
    
    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea name="Description" class="form-control" rows="3"></textarea>
    </div>
    
    <div class="mb-3">
        <label class="form-label">Quantity *</label>
        <input type="number" name="Quantity" class="form-control" value="1" min="1" required />
    </div>
    
    <div class="mb-3">
        <label class="form-label">Condition *</label>
        <select name="Condition" class="form-select" required>
            <option value="Excellent">Excellent</option>
            <option value="Good">Good</option>
            <option value="Fair">Fair</option>
            <option value="Poor">Poor</option>
        </select>
    </div>
    
    <div class="mb-3">
        <label class="form-label">Estimated Value (R) *</label>
        <input type="number" name="EstimatedValue" step="0.01" class="form-control" required />
    </div>
    
    <div class="mb-3">
        <label class="form-label">Reserve Price (R) *</label>
        <input type="number" name="ReservePrice" step="0.01" class="form-control" required />
    </div>
    
    <button type="submit" class="btn btn-gold">Add to Catalogue</button>
</form>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-4">
                    <h5 class="mb-0">Instructions</h5>
                </div>
                <div class="card-body">
                    <p>For each item in the customer's storage unit:</p>
                    <ol class="small">
                        <li>Inspect the item condition</li>
                        <li>Record item name and description</li>
                        <li>Count the quantity</li>
                        <li>Assess condition rating</li>
                        <li>Estimate current market value</li>
                        <li>Set a reserve price (minimum bid)</li>
                    </ol>
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Note:</strong> Only approved breach cases can be catalogued for sale.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-gold {
        background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);
        color: #1A1A1A;
        font-weight: 600;
        border: none;
    }
    .btn-outline-gold {
        border: 2px solid #D4AF37;
        color: #D4AF37;
        background: transparent;
    }
</style>