@model IEnumerable<SmartStorage.Core.Entities.ContractExtension>
@{
    ViewData["Title"] = "Pending Extensions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);">
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <div class="d-flex align-items-center mb-2">
                                <div class="me-3 p-2 bg-white bg-opacity-20 rounded-3">
                                    <i class="bi bi-calendar-check fs-1 text-gold"></i>
                                </div>
                                <div>
                                    <h1 class="text-white mb-1 fw-bold">Extension Requests</h1>
                                    <p class="text-white-50 mb-0">Review and approve contract extension requests</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 text-end">
                            <a href="/Admin/Dashboard" class="btn btn-outline-light rounded-pill">
                                <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-lg rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Contract #</th>
                            <th>Customer</th>
                            <th>Unit</th>
                            <th>Requested Days</th>
                            <th>Current End Date</th>
                            <th>Proposed End Date</th>
                            <th>Reason</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var ext in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@ext.Contract?.ContractNumber</td>
                                    <td>@ext.Contract?.Client?.FullName</td>
                                    <td>@ext.Contract?.Booking?.StorageUnit?.UnitNumber</td>
                                    <td><span class="badge bg-info">@ext.RequestedDays days</span></td>
                                    <td>@ext.CurrentEndDate.ToString("dd MMM yyyy")</td>
                                    <td><span class="fw-bold text-success">@ext.ProposedNewEndDate.ToString("dd MMM yyyy")</span></td>
                                    <td style="max-width: 200px;">@(ext.Reason.Length > 50 ? ext.Reason.Substring(0, 50) + "..." : ext.Reason)</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-success rounded-pill me-1" data-bs-toggle="modal" data-bs-target="#approveModal-@ext.Id">
                                            <i class="bi bi-check-circle"></i> Approve
                                        </button>
                                        <button type="button" class="btn btn-sm btn-danger rounded-pill" data-bs-toggle="modal" data-bs-target="#rejectModal-@ext.Id">
                                            <i class="bi bi-x-circle"></i> Reject
                                        </button>
                                    </td>
                                </tr>

                                <!-- Approve Modal -->
                                <div class="modal fade" id="approveModal-@ext.Id" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content rounded-4">
                                            <div class="modal-header" style="background: linear-gradient(135deg, #28a745, #20c997);">
                                                <h5 class="modal-title text-white">Approve Extension Request</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                            </div>
                                            <form asp-action="ApproveExtension" asp-route-id="@ext.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-body">
                                                    <p><strong>Contract:</strong> @ext.Contract?.ContractNumber</p>
                                                    <p><strong>Customer:</strong> @ext.Contract?.Client?.FullName</p>
                                                    <p><strong>Current End Date:</strong> @ext.CurrentEndDate.ToString("dd MMM yyyy")</p>
                                                    <p><strong>New End Date:</strong> <span class="fw-bold text-success">@ext.ProposedNewEndDate.ToString("dd MMM yyyy")</span></p>
                                                    <div class="form-floating mt-3">
                                                        <textarea name="adminNotes" class="form-control" placeholder="Admin notes" style="height: 100px"></textarea>
                                                        <label>Admin Notes (Optional)</label>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-success rounded-pill">Approve Extension</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- Reject Modal -->
                                <div class="modal fade" id="rejectModal-@ext.Id" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content rounded-4">
                                            <div class="modal-header bg-danger">
                                                <h5 class="modal-title text-white">Reject Extension Request</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                            </div>
                                            <form asp-action="RejectExtension" asp-route-id="@ext.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-body">
                                                    <p><strong>Contract:</strong> @ext.Contract?.ContractNumber</p>
                                                    <p><strong>Customer:</strong> @ext.Contract?.Client?.FullName</p>
                                                    <div class="form-floating mt-3">
                                                        <textarea name="adminNotes" class="form-control" placeholder="Reason for rejection" style="height: 100px" required></textarea>
                                                        <label>Reason for Rejection *</label>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-danger rounded-pill">Reject Request</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <i class="bi bi-inbox fs-1 text-muted"></i>
                                    <p class="text-muted mt-2 mb-0">No pending extension requests</p>
                                    <small class="text-muted">All caught up!</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: #D4AF37 !important;
    }
    .bg-gold {
        background-color: #D4AF37 !important;
    }
    .rounded-4 {
        border-radius: 1rem !important;
    }
    .btn-outline-light:hover {
        background: #D4AF37;
        border-color: #D4AF37;
        color: #1A1A1A;
    }
    .table > :not(caption) > * > * {
        vertical-align: middle;
    }
</style>