@model IEnumerable<SmartStorage.Core.Entities.Auction>
@{
    ViewData["Title"] = "All Auctions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 mb-0">All Auctions</h1>
        <p class="text-muted">View all auctions and their bids</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Auction Number</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Starting Bid</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var auction in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@auction.AuctionNumber</td>
                                    <td>@auction.StartDate.ToString("dd MMM yyyy")</td>
                                    <td>@auction.EndDate.ToString("dd MMM yyyy HH:mm")</td>
                                    <td>R @auction.StartingBid.ToString("N2")</td>
                                    <td>
                                        @if (auction.Status == "Published")
                                        {
                                            if (auction.EndDate < DateTime.Now)
                                            {
                                                <span class="badge bg-warning">Ended - Ready to Close</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                        }
                                        else if (auction.Status == "Closed")
                                        {
                                            <span class="badge bg-secondary">Closed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@auction.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/Admin/AuctionBids/@auction.Id" class="btn btn-sm btn-gold">View Bids</a>
                                        
                                        @if (auction.Status == "Published" && auction.EndDate < DateTime.Now)
                                        {
                                            <form method="post" action="/Admin/CloseAuction/@auction.Id" style="display:inline-block; margin-left:5px;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Close this auction and declare the winner?')">Close Auction</button>
                                            </form>
                                        }
                                        
                                        @if (auction.Status == "Closed" && auction.WinnerId != null)
                                        {
                                            <span class="badge bg-gold text-dark mt-1">🏆 Winner Selected</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">No auctions found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <div class="mt-3">
        <a href="/Admin/Dashboard" class="btn btn-outline-gold">← Back to Dashboard</a>
    </div>
</div>

<style>
    .btn-gold {
        background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);
        color: #1A1A1A;
        font-weight: 600;
        border: none;
        padding: 5px 15px;
        border-radius: 5px;
        text-decoration: none;
        display: inline-block;
    }
    .btn-outline-gold {
        border: 2px solid #D4AF37;
        color: #D4AF37;
        background: transparent;
        padding: 8px 20px;
        border-radius: 5px;
        text-decoration: none;
        display: inline-block;
    }
    .btn-outline-gold:hover {
        background: #D4AF37;
        color: #1A1A1A;
    }
    .bg-gold {
        background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);
        color: #1A1A1A;
    }
    .table td {
        vertical-align: middle;
    }
    .btn-sm {
        padding: 4px 10px;
        font-size: 12px;
    }
</style>