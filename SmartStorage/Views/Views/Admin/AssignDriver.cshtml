@using SmartStorage.Core.Entities
@{
    ViewData["Title"] = "Assign Driver";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var schedule = ViewBag.Schedule as DeliverySchedule;
    var drivers = ViewBag.Drivers as IEnumerable<dynamic>;
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 mb-0">Assign Driver to Transport Job</h1>
        <p class="text-muted">Select an available driver and assign them to a scheduled transport job</p>
    </div>

    <div class="row">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Transport Job Details</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th width="40%">Schedule #:</th>
                            <td>@schedule?.ScheduleNumber</td
                        </tr>
                        <tr>
                            <th>Client:</th>
                            <td>@schedule?.Booking?.Client?.FullName</td
                        </tr>
                        <tr>
                            <th>Unit:</th>
                            <td>@schedule?.Booking?.StorageUnit?.UnitNumber</td
                        </tr>
                        <tr>
                            <th>Delivery Type:</th>
                            <td>@schedule?.DeliveryType</td
                        </tr>
                        <tr>
                            <th>Scheduled Date:</th>
                            <td>@schedule?.ScheduledDate.ToString("dd MMM yyyy")</td
                        </tr>
                        <tr>
                            <th>Time Slot:</th>
                            <td>@schedule?.TimeSlot</td
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Select Driver</h5>
                </div>
                <div class="card-body">
                    <form method="post" action="/Admin/AssignDriver">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="scheduleId" value="@schedule?.Id" />
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Available Drivers</label>
                            <select name="driverId" class="form-select form-select-lg" required>
                                <option value="">-- Select a Driver --</option>
                                @if (drivers != null)
                                {
                                    foreach (var driver in drivers)
                                    {
                                        <option value="@driver.Id">@driver.FullName - Vehicle: @driver.VehicleAssigned | Phone: @driver.Phone</option>
                                    }
                                }
                            </select>
                            <small class="text-muted">Only active drivers are shown</small>
                        </div>
                        
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <small>Once assigned, the driver will be notified and the transport job status will be updated to "Confirmed".</small>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-gold">Assign Driver</button>
                            <a href="/Admin/ScheduleTransport" class="btn btn-outline-gold">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-gold {
        background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);
        color: #1A1A1A;
        font-weight: 600;
        border: none;
        padding: 10px 25px;
        border-radius: 8px;
    }
    .btn-outline-gold {
        border: 2px solid #D4AF37;
        color: #D4AF37;
        background: transparent;
        padding: 10px 25px;
        border-radius: 8px;
        text-decoration: none;
    }
    .btn-outline-gold:hover {
        background: #D4AF37;
        color: #1A1A1A;
    }
    .table th {
        font-weight: 600;
        color: #555;
    }
</style>