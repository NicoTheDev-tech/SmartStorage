@using SmartStorage.Core.Entities
@model DeliverySchedule
@{
    ViewData["Title"] = "Execute Delivery";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 mb-0">Execute Delivery Job</h1>
        <p class="text-muted">Physically perform pickup or delivery and secure proof of completion</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Job Details</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th width="40%">Schedule #:</th>
                            <td>@Model.ScheduleNumber</td
                        </tr>
                        <tr>
                            <th>Client:</th>
                            <td>@Model.Booking?.Client?.FullName</td
                        </tr>
                        <tr>
                            <th>Unit:</th>
                            <td>@Model.Booking?.StorageUnit?.UnitNumber</td
                        </tr>
                        <tr>
                            <th>Delivery Type:</th>
                            <td>@Model.DeliveryType</td
                        </tr>
                        <tr>
                            <th>Address:</th>
                            <td>@(Model.DeliveryType == DeliveryType.Dropoff ? Model.DeliveryAddress : Model.PickupAddress)</td
                        </tr>
                        <tr>
                            <th>Contact:</th>
                            <td>@Model.ContactPerson - @Model.ContactPhone</td
                        </tr>
                        <tr>
                            <th>Goods:</th>
                            <td>@Model.GoodsDescription</td
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Proof of Completion</h5>
                </div>
                <div class="card-body">
                    <form method="post" action="/Driver/ExecuteDelivery">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="scheduleId" value="@Model.Id" />
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Proof of Delivery</label>
                            <textarea name="proofOfDelivery" class="form-control" rows="2" placeholder="Describe what was delivered/picked up, condition, quantity..." required></textarea>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Customer Signature / Confirmation</label>
                            <textarea name="customerSignature" class="form-control" rows="2" placeholder="Customer name, signature, or confirmation number..." required></textarea>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Driver Notes</label>
                            <textarea name="notes" class="form-control" rows="2" placeholder="Any issues, delays, or special notes..."></textarea>
                        </div>
                        
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle"></i>
                            <small>By submitting this form, you confirm that the delivery/pickup has been completed successfully.</small>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-gold">Mark as Completed</button>
                            <a href="/Driver/MyDeliveries" class="btn btn-outline-gold">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-gold {
        background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);
        color: #1A1A1A;
        font-weight: 600;
        border: none;
        padding: 10px 25px;
        border-radius: 8px;
    }
    .btn-outline-gold {
        border: 2px solid #D4AF37;
        color: #D4AF37;
        background: transparent;
        padding: 10px 25px;
        border-radius: 8px;
        text-decoration: none;
    }
    .btn-outline-gold:hover {
        background: #D4AF37;
        color: #1A1A1A;
    }
    .table th {
        font-weight: 600;
        color: #555;
    }
</style>