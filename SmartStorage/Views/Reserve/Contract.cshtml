@using SmartStorage.Core.Entities
@model Booking

@{
    ViewData["Title"] = "Storage Contract";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg">
                <div class="card-header text-center py-4" style="background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);">
                    <i class="bi bi-file-text fs-1 text-white"></i>
                    <h2 class="text-white mb-0 mt-2">Storage Contract</h2>
                    <p class="text-white-50 mb-0">Please review and sign your contract</p>
                </div>
                <div class="card-body p-4">
                    <!-- Contract Details -->
                    <div class="mb-4">
                        <h5 class="fw-bold text-gold">Contract Summary</h5>
                        <div class="row g-3 mt-2">
                            <div class="col-md-6">
                                <div class="bg-light p-3 rounded">
                                    <small class="text-muted">Booking Number</small>
                                    <p class="fw-bold mb-0">@Model.BookingNumber</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="bg-light p-3 rounded">
                                    <small class="text-muted">Storage Unit</small>
                                    <p class="fw-bold mb-0">Unit @Model.StorageUnit?.UnitNumber</p>
                                    <small>@Model.StorageUnit?.Size</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="bg-light p-3 rounded">
                                    <small class="text-muted">Start Date</small>
                                    <p class="fw-bold mb-0">@Model.StartDate.ToString("dd MMM yyyy")</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="bg-light p-3 rounded">
                                    <small class="text-muted">End Date</small>
                                    <p class="fw-bold mb-0">@Model.EndDate.ToString("dd MMM yyyy")</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="bg-light p-3 rounded">
                                    <small class="text-muted">Monthly Rate</small>
                                    <p class="fw-bold mb-0 text-gold">R @Model.StorageUnit?.MonthlyRate.ToString("N2")</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="bg-light p-3 rounded">
                                    <small class="text-muted">Total Amount Due</small>
                                    <p class="fw-bold mb-0 text-gold">R @Model.TotalAmount.ToString("N2")</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Terms and Conditions -->
                    <div class="mb-4">
                        <h5 class="fw-bold text-gold">Terms and Conditions</h5>
                        <div class="border rounded p-3" style="height: 300px; overflow-y: auto; background-color: #f8f9fa;">
                            <pre style="white-space: pre-wrap; font-family: inherit; font-size: 14px;">@GetContractTerms()</pre>
                        </div>
                    </div>

                    <!-- Signature Section -->
                    <div class="mb-4">
                        <h5 class="fw-bold text-gold">Electronic Signature</h5>
                        <div class="bg-light p-4 rounded">
                            <div class="form-check mb-3">
                                <input type="checkbox" class="form-check-input" id="agreeTerms">
                                <label class="form-check-label fw-semibold" for="agreeTerms">
                                    I have read, understood, and agree to the Terms and Conditions
                                </label>
                            </div>
                            <div class="form-check mb-3">
                                <input type="checkbox" class="form-check-input" id="agreeData">
                                <label class="form-check-label fw-semibold" for="agreeData">
                                    I consent to the processing of my personal information
                                </label>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Full Name (as signature)</label>
                                <input type="text" class="form-control" id="signatureName" placeholder="Enter your full name">
                                <small class="text-muted">This will serve as your electronic signature</small>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Date</label>
                                <input type="text" class="form-control" id="signatureDate" value="@DateTime.Now.ToString("dd MMM yyyy")" readonly>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a href="/Reserve" class="btn btn-outline-secondary">Cancel</a>
                        <button type="button" class="btn btn-gold btn-lg" id="signContractBtn" disabled>
                            <i class="bi bi-pen"></i> Sign & Continue to Payment
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetContractTerms()
    {
        return @"
SMARTSTORAGE STORAGE CONTRACT TERMS AND CONDITIONS

1. STORAGE UNIT RENTAL
   - The Customer agrees to rent the storage unit for the agreed period
   - Monthly rental fees are payable in advance on the 1st of each month
   - A 10% late fee will be applied to payments received after the 5th of the month

2. SECURITY DEPOSIT
   - A security deposit of R50 is required
   - Deposit is refundable upon contract termination with 30 days written notice

3. PROHIBITED ITEMS
   - Hazardous materials, perishable goods, illegal substances, flammable materials

4. ACCESS AND SECURITY
   - 24/7 access with valid ID and access code
   - Customer is responsible for their own locks and security

5. CONTRACT EXTENSION
   - Customer may request a contract extension at least 30 days prior to the contract end date

6. DEFAULT AND ABANDONED PROPERTY
   - Failure to pay rental fees for 30 consecutive days constitutes default
   - After 60 days of non-payment, property may be sold to recover outstanding fees

7. INSURANCE
   - Customer is strongly advised to maintain comprehensive insurance for stored items
   - SmartStorage is not liable for loss, damage, or theft of stored items

8. TERMINATION
   - 30 days written notice required for contract termination

I have read, understood, and agree to the above terms and conditions.
";
    }
}

@section Scripts {
    <script>
        $(document).ready(function() {
            function checkForm() {
                var agreeTerms = $('#agreeTerms').is(':checked');
                var agreeData = $('#agreeData').is(':checked');
                var signatureName = $('#signatureName').val().trim();

                if (agreeTerms && agreeData && signatureName !== '') {
                    $('#signContractBtn').prop('disabled', false);
                } else {
                    $('#signContractBtn').prop('disabled', true);
                }
            }

            $('#agreeTerms, #agreeData, #signatureName').on('change keyup', checkForm);

            $('#signContractBtn').click(function() {
                var signatureName = $('#signatureName').val().trim();

                $.ajax({
                    url: '/Reserve/SignContract',
                    method: 'POST',
                    data: {
                        bookingId: @Model.Id,
                        signatureName: signatureName
                    },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            window.location.href = '/Invoice/Pay/' + response.bookingId;
                        } else {
                            alert('Error: ' + response.error);
                        }
                    },
                    error: function() {
                        alert('Error signing contract. Please try again.');
                    }
                });
            });
        });
    </script>
}

<style>
    .text-gold {
        color: var(--gold);
    }

    .btn-gold {
        background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);
        color: #2c2c2c;
        font-weight: 600;
        border: none;
    }

        .btn-gold:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(212,175,55,0.3);
            color: #2c2c2c;
        }

    pre {
        white-space: pre-wrap;
        font-family: inherit;
    }
</style>