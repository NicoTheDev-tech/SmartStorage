@using SmartStorage.Core.Entities
@model DeliverySchedule
@{
    ViewData["Title"] = "Prepare Transport Job";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 mb-0">Prepare Transport Job</h1>
        <p class="text-muted">Verify goods, complete vehicle checks, and ready paperwork before job begins</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Job Details</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th width="40%">Schedule #:</th>
                            <td>@Model.ScheduleNumber</td
                        </tr>
                        <tr>
                            <th>Client:</th>
                            <td>@Model.Booking?.Client?.FullName</td
                        </tr>
                        <tr>
                            <th>Unit:</th>
                            <td>@Model.Booking?.StorageUnit?.UnitNumber</td
                        </tr>
                        <tr>
                            <th>Delivery Type:</th>
                            <td>@Model.DeliveryType</td
                        </tr>
                        <tr>
                            <th>Driver:</th>
                            <td>@Model.AssignedDriver?.FullName</td
                        </tr>
                        <tr>
                            <th>Scheduled Date:</th>
                            <td>@Model.ScheduledDate.ToString("dd MMM yyyy")</td
                        </tr>
                        <tr>
                            <th>Time Slot:</th>
                            <td>@Model.TimeSlot</td
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Preparation Checklist</h5>
                </div>
                <div class="card-body">
                    <form method="post" action="/Warehouse/PrepareTransport">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="scheduleId" value="@Model.Id" />
                        
                        <div class="mb-3">
                            <div class="form-check">
                                <input type="checkbox" id="goodsVerified" name="goodsVerified" value="true" class="form-check-input" required />
                                <label class="form-check-label fw-bold" for="goodsVerified">
                                    <i class="bi bi-box-seam text-success me-2"></i> Goods Verified
                                </label>
                                <p class="small text-muted ms-4">Verify all items match the goods description and quantity</p>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <div class="form-check">
                                <input type="checkbox" id="vehicleChecked" name="vehicleChecked" value="true" class="form-check-input" required />
                                <label class="form-check-label fw-bold" for="vehicleChecked">
                                    <i class="bi bi-truck text-success me-2"></i> Vehicle Checked
                                </label>
                                <p class="small text-muted ms-4">Complete pre-departure vehicle inspection (fuel, tires, lights)</p>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <div class="form-check">
                                <input type="checkbox" id="paperworkReady" name="paperworkReady" value="true" class="form-check-input" required />
                                <label class="form-check-label fw-bold" for="paperworkReady">
                                    <i class="bi bi-file-text text-success me-2"></i> Paperwork Ready
                                </label>
                                <p class="small text-muted ms-4">All delivery documents, invoices, and proof of delivery forms ready</p>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Preparation Notes</label>
                            <textarea name="notes" class="form-control" rows="3" placeholder="Any special instructions or notes for the driver..."></textarea>
                        </div>
                        
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i>
                            <small>All three checks must be completed before the job can be marked as prepared.</small>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-gold">Mark as Prepared</button>
                            <a href="/Warehouse/Dashboard" class="btn btn-outline-gold">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-gold {
        background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);
        color: #1A1A1A;
        font-weight: 600;
        border: none;
        padding: 10px 25px;
        border-radius: 8px;
    }
    .btn-outline-gold {
        border: 2px solid #D4AF37;
        color: #D4AF37;
        background: transparent;
        padding: 10px 25px;
        border-radius: 8px;
        text-decoration: none;
    }
    .btn-outline-gold:hover {
        background: #D4AF37;
        color: #1A1A1A;
    }
    .form-check-input:checked {
        background-color: #28a745;
        border-color: #28a745;
    }
    .table th {
        font-weight: 600;
        color: #555;
    }
</style>