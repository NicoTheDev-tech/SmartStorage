@model SmartStorage.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Staff Registration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header text-center py-4 rounded-top-4" style="background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);">
                    <i class="bi bi-person-badge fs-1 text-white"></i>
                    <h3 class="text-white mb-0 mt-2">Staff Registration</h3>
                    <p class="text-white-50 mb-0">Create staff account</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="RegisterStaff" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Full Name -->
                        <div class="form-floating mb-3">
                            <input asp-for="FullName" class="form-control" placeholder="Full Name" />
                            <label asp-for="FullName">
                                <i class="bi bi-person-badge me-1"></i> Full Name
                            </label>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <!-- Preferred Name -->
                        <div class="form-floating mb-3">
                            <input asp-for="PreferredName" class="form-control" placeholder="Preferred Name" />
                            <label asp-for="PreferredName">
                                <i class="bi bi-person-heart me-1"></i> Preferred Name
                            </label>
                            <span asp-validation-for="PreferredName" class="text-danger small"></span>
                            <div class="form-text">What should we call you?</div>
                        </div>

                        <!-- Email Address -->
                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control" placeholder="Email Address" type="email" />
                            <label asp-for="Email">
                                <i class="bi bi-envelope me-1"></i> Email Address
                            </label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Role Selection -->
                        <div class="form-floating mb-3">
                            <select name="role" class="form-select" id="roleSelect">
                                <option value="Staff">General Staff</option>
                                <option value="WarehouseStaff">Warehouse Staff</option>
                                <option value="InventoryStaff">Inventory Staff</option>
                                <option value="CustomerSupport">Customer Support</option>
                                <option value="Driver">Driver</option>
                                <option value="OperationsManager">Operations Manager</option>
                            </select>
                            <label for="roleSelect">
                                <i class="bi bi-briefcase me-1"></i> Staff Role
                            </label>
                        </div>

                        <!-- Password -->
                        <div class="form-floating mb-3">
                            <input asp-for="Password" class="form-control" type="password" placeholder="Password" />
                            <label asp-for="Password">
                                <i class="bi bi-key me-1"></i> Password
                            </label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                            <div class="form-text">Minimum 6 characters</div>
                        </div>

                        <!-- Confirm Password -->
                        <div class="form-floating mb-4">
                            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Confirm Password" />
                            <label asp-for="ConfirmPassword">
                                <i class="bi bi-key-fill me-1"></i> Confirm Password
                            </label>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-dark w-100 py-3">
                            <i class="bi bi-person-plus me-2"></i> Register Staff
                        </button>

                        <hr class="my-4" />

                        <!-- Back Link -->
                        <p class="text-center mb-0">
                            <a asp-controller="Admin" asp-action="Dashboard" class="text-decoration-none" style="color: #B8860B;">
                                <i class="bi bi-arrow-left"></i> Back to Dashboard
                            </a>
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-floating > .form-control:focus,
    .form-floating > .form-select:focus {
        border-color: #D4AF37;
        box-shadow: 0 0 0 0.2rem rgba(212, 175, 55, 0.25);
    }
    
    .card {
        background: #FFFFFF;
    }
    
    .rounded-top-4 {
        border-top-left-radius: 1rem !important;
        border-top-right-radius: 1rem !important;
    }
    
    .btn-dark {
        background: linear-gradient(135deg, #2C2C2C 0%, #1A1A1A 100%);
        border: none;
        transition: all 0.3s ease;
    }
    
    .btn-dark:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}