@model IEnumerable<SmartStorage.Core.Entities.AuctionBid>
@{
    ViewData["Title"] = "Auction Bids";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var auction = ViewBag.Auction as SmartStorage.Core.Entities.Auction;
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 mb-0">Bids for @auction?.AuctionNumber</h1>
        <p class="text-muted">End Date: @auction?.EndDate.ToString("dd MMM yyyy HH:mm")</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Bidder Name</th>
                            <th>Bid Amount</th>
                            <th>Bid Time</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var bid in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@bid.BidderName</td>
                                    <td class="fw-bold text-success">R @bid.BidAmount.ToString("N2")</td>
                                    <td>@bid.BidTime.ToString("dd MMM yyyy HH:mm")</td>
                                    <td>
                                        @if (bid.Status == "Active")
                                        {
                                            <span class="badge bg-success">Highest Bid</span>
                                        }
                                        else if (bid.Status == "Won")
                                        {
                                            <span class="badge bg-warning text-dark">🏆 WINNER! 🏆</span>
                                        }
                                        else if (bid.Status == "Lost")
                                        {
                                            <span class="badge bg-secondary">Outbid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@bid.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4">No bids yet</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a href="/Admin/AllAuctions" class="btn btn-outline-gold">← Back to Auctions</a>
    </div>
</div>

<style>
    .btn-outline-gold {
        border: 2px solid #D4AF37;
        color: #D4AF37;
        background: transparent;
        padding: 8px 20px;
        border-radius: 5px;
        text-decoration: none;
        display: inline-block;
    }
    .btn-outline-gold:hover {
        background: #D4AF37;
        color: #1A1A1A;
    }
    .table td {
        vertical-align: middle;
    }
    .table th {
        vertical-align: middle;
    }
</style>