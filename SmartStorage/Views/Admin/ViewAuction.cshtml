@model SmartStorage.Core.Entities.Auction
@{
    ViewData["Title"] = "View Auction";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var items = ViewBag.Items as List<SmartStorage.Core.Entities.AuctionItem>;
    var bids = ViewBag.Bids as List<SmartStorage.Core.Entities.AuctionBid>;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-0">Auction Details</h1>
            <p class="text-muted">@Model.AuctionNumber</p>
        </div>
        <a href="/Admin/BreachCases" class="btn btn-outline-gold">Back to Breach Cases</a>
    </div>

    <!-- Auction Info -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <small class="text-muted">Status</small>
                    <p><span class="badge bg-success">@Model.Status</span></p>
                </div>
                <div class="col-md-3">
                    <small class="text-muted">Start Date</small>
                    <p>@Model.StartDate.ToString("dd MMM yyyy HH:mm")</p>
                </div>
                <div class="col-md-3">
                    <small class="text-muted">End Date</small>
                    <p>@Model.EndDate.ToString("dd MMM yyyy HH:mm")</p>
                </div>
                <div class="col-md-3">
                    <small class="text-muted">Starting Bid</small>
                    <p class="fw-bold">R @Model.StartingBid.ToString("N2")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Auction Items -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Items for Auction</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Item Name</th>
                            <th>Reserve Price</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (items != null && items.Any())
                        {
                            foreach (var item in items)
                            {
                                <tr>
                                    <td>@item.ItemName</td>
                                    <td>R @item.ReservePrice.ToString("N2")</td>
                                    <td><span class="badge bg-info">@item.Status</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-center">No items found</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Bids -->
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0">Current Bids</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Bidder</th>
                            <th>Bid Amount</th>
                            <th>Bid Time</th>
                        </thead
                    </thead>
                    <tbody>
                        @if (bids != null && bids.Any())
                        {
                            foreach (var bid in bids)
                            {
                                <tr>
                                    <td>@bid.BidderName</td>
                                    <td class="fw-bold text-success">R @bid.BidAmount.ToString("N2")</td>
                                    <td>@bid.BidTime.ToString("dd MMM yyyy HH:mm")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-center">No bids yet</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-outline-gold {
        border: 2px solid #D4AF37;
        color: #D4AF37;
        background: transparent;
        padding: 5px 15px;
        border-radius: 5px;
        text-decoration: none;
    }
    .btn-outline-gold:hover {
        background: #D4AF37;
        color: #1A1A1A;
    }
</style>