@using SmartStorage.Core.Entities
@model IEnumerable<SmartStorage.Core.Entities.DeliverySchedule>
@{
    ViewData["Title"] = "Schedule Transport Job";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var timeSlots = ViewBag.TimeSlots as List<string>;
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 mb-0">Schedule Transport Job</h1>
        <p class="text-muted">Plan and assign confirmed date, time, and route for cartage pickup or delivery</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Schedule #</th>
                            <th>Client</th>
                            <th>Unit</th>
                            <th>Delivery Type</th>
                            <th>Current Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var schedule in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@schedule.ScheduleNumber</td>
                                    <td>@schedule.Booking?.Client?.FullName</td>
                                    <td>@schedule.Booking?.StorageUnit?.UnitNumber</td>
                                    <td>
                                        @if (schedule.DeliveryType == DeliveryType.Dropoff)
                                        {
                                            <span class="badge bg-info">Dropoff</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Pickup</span>
                                        }
                                    </td>
                                    <td>@schedule.ScheduledDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-gold" onclick="openScheduleModal(@schedule.Id, '@schedule.ScheduleNumber', '@schedule.Booking?.Client?.FullName', '@schedule.DeliveryType')">
                                            <i class="bi bi-calendar-plus"></i> Schedule
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">No pending transport jobs found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a href="/Admin/Dashboard" class="btn btn-outline-gold">← Back to Dashboard</a>
    </div>
</div>

<!-- Schedule Modal -->
<div class="modal fade" id="scheduleModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">
            <div class="modal-header" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);">
                <h5 class="modal-title text-white">Schedule Transport Job</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/Admin/ScheduleTransport" id="scheduleForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="scheduleId" id="modalScheduleId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Schedule #</label>
                        <p id="modalScheduleNumber" class="border-bottom pb-1"></p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Client</label>
                        <p id="modalClientName" class="border-bottom pb-1"></p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Delivery Type</label>
                        <p id="modalDeliveryType" class="border-bottom pb-1"></p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Scheduled Date *</label>
                        <input type="date" name="scheduledDate" class="form-control" required min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Time Slot *</label>
                        <select name="timeSlot" class="form-select" required>
                            <option value="">Select time slot</option>
                            @if (timeSlots != null)
                            {
                                foreach (var slot in timeSlots)
                                {
                                    <option value="@slot">@slot</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Route / Address</label>
                        <textarea name="route" class="form-control" rows="2" placeholder="Enter pickup/delivery address and route details"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Admin Notes</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Special instructions for driver"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-gold">Confirm Schedule</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .btn-gold {
        background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);
        color: #1A1A1A;
        font-weight: 600;
        border: none;
        padding: 5px 15px;
        border-radius: 5px;
    }
    .btn-outline-gold {
        border: 2px solid #D4AF37;
        color: #D4AF37;
        background: transparent;
        padding: 8px 20px;
        border-radius: 5px;
        text-decoration: none;
    }
    .btn-outline-gold:hover {
        background: #D4AF37;
        color: #1A1A1A;
    }
    .table td {
        vertical-align: middle;
    }
</style>

<script>
    function openScheduleModal(id, scheduleNumber, clientName, deliveryType) {
        document.getElementById('modalScheduleId').value = id;
        document.getElementById('modalScheduleNumber').innerText = scheduleNumber;
        document.getElementById('modalClientName').innerText = clientName;
        document.getElementById('modalDeliveryType').innerText = deliveryType;
        
        var modalEl = document.getElementById('scheduleModal');
        var modal = new bootstrap.Modal(modalEl);
        modal.show();
    }
</script>